     }
    ],
    "UserData": {
     "Fn::Base64": "#!/bin/bash\nset -euxo pipefail\nTOKEN=$(curl -X PUT \"http://169.254.169.254/latest/api/token\" -H \"X-aws-ec2-metadata-token-ttl-seconds: 21600\")\nPRIVATE_IP=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" http://169.254.169.254/latest/meta-data/local-ipv4)\ndocker info --format \"{{.Swarm.LocalNodeState}}\" | grep -q \"^active$\" || docker swarm init --advertise-addr \"$PRIVATE_IP\"\nJOIN_TOKEN=$(docker swarm join-token worker -q)\naws ssm put-parameter --region ap-southeast-2 --name \"/docker-swarm/DockerStack/worker-join-command\" --type SecureString --overwrite --value \"docker swarm join --token $JOIN_TOKEN $PRIVATE_IP:2377\""
    }
   },
