     "UserData": {
      "Fn::Base64": "#!/bin/bash\nset -euxo pipefail\nTOKEN=$(curl -X PUT \"http://169.254.169.254/latest/api/token\" -H \"X-aws-ec2-metadata-token-ttl-seconds: 21600\")\nPRIVATE_IP=$(curl -H \"X-aws-ec2-metadata-token: $TOKEN\" http://169.254.169.254/latest/meta-data/local-ipv4)\nif aws ssm put-parameter --region ap-southeast-2 --name \"/docker-swarm/DockerStack/bootstrap-manager-ip\" --type String --value \"$PRIVATE_IP\" --no-overwrite; then\n  docker info --format \"{{.Swarm.LocalNodeState}}\" | grep -q \"^active$\" || docker swarm init --advertise-addr \"$PRIVATE_IP\"\n  MANAGER_TOKEN=$(docker swarm join-token manager -q)\n  WORKER_TOKEN=$(docker swarm join-token worker -q)\n  aws ssm put-parameter --region ap-southeast-2 --name \"/docker-swarm/DockerStack/manager-join-command\" --type SecureString --overwrite --value \"docker swarm join --token $MANAGER_TOKEN $PRIVATE_IP:2377\"\n  aws ssm put-parameter --region ap-southeast-2 --name \"/docker-swarm/DockerStack/worker-join-command\" --type SecureString --overwrite --value \"docker swarm join --token $WORKER_TOKEN $PRIVATE_IP:2377\"\nelse\n  for i in $(seq 1 60); do MANAGER_JOIN_COMMAND=$(aws ssm get-parameter --region ap-southeast-2 --name \"/docker-swarm/DockerStack/manager-join-command\" --with-decryption --query Parameter.Value --output text 2>/dev/null) && break; sleep 10; done\n  test -n \"${MANAGER_JOIN_COMMAND:-}\"\n  docker info --format \"{{.Swarm.LocalNodeState}}\" | grep -q \"^active$\" || $MANAGER_JOIN_COMMAND\nfi"
     }
